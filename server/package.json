{
  "private": true,
  "name": "my-app",
  "version": "1.0.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "main": "build/index.js",
  "engines": {
    "node": ">= 16.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-require-module build/index.js",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/cloud": "^1.0.12",
    "@colyseus/loadtest": "^0.17.8",
    "@colyseus/testing": "^0.17.11",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.10",
    "mocha": "^10.8.2",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/auth": "^0.17.6",
    "@colyseus/monitor": "^0.17.7",
    "@colyseus/playground": "^0.17.10",
    "@colyseus/schema": "^4.0.12",
    "@colyseus/tools": "^0.17.18",
    "colyseus": "^0.17.8",
    "express": "^4.18.2",
    "tsx": "^4.19.4"
  }
}
